{
  "name": "atelier-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A thoughtful React component library and interactive demo.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": { "node": ">=20.19.0" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./button": { "types": "./dist/entries/button.d.ts", "import": "./dist/button.js", "require": "./dist/button.cjs" },
    "./input": { "types": "./dist/entries/input.d.ts", "import": "./dist/input.js", "require": "./dist/input.cjs" },
    "./textarea": { "types": "./dist/entries/textarea.d.ts", "import": "./dist/textarea.js", "require": "./dist/textarea.cjs" },
    "./select": { "types": "./dist/entries/select.d.ts", "import": "./dist/select.js", "require": "./dist/select.cjs" },
    "./checkbox": { "types": "./dist/entries/checkbox.d.ts", "import": "./dist/checkbox.js", "require": "./dist/checkbox.cjs" },
    "./radio": { "types": "./dist/entries/radio.d.ts", "import": "./dist/radio.js", "require": "./dist/radio.cjs" },
    "./switch": { "types": "./dist/entries/switch.d.ts", "import": "./dist/switch.js", "require": "./dist/switch.cjs" },
    "./modal": { "types": "./dist/entries/modal.d.ts", "import": "./dist/modal.js", "require": "./dist/modal.cjs" },
    "./table": { "types": "./dist/entries/table.d.ts", "import": "./dist/table.js", "require": "./dist/table.cjs" },
    "./alert": { "types": "./dist/entries/alert.d.ts", "import": "./dist/alert.js", "require": "./dist/alert.cjs" },
    "./tag": { "types": "./dist/entries/tag.d.ts", "import": "./dist/tag.js", "require": "./dist/tag.cjs" },
    "./avatar": { "types": "./dist/entries/avatar.d.ts", "import": "./dist/avatar.js", "require": "./dist/avatar.cjs" },
    "./tooltip": { "types": "./dist/entries/tooltip.d.ts", "import": "./dist/tooltip.js", "require": "./dist/tooltip.cjs" },
    "./badge": { "types": "./dist/entries/badge.d.ts", "import": "./dist/badge.js", "require": "./dist/badge.cjs" },
    "./breadcrumb": { "types": "./dist/entries/breadcrumb.d.ts", "import": "./dist/breadcrumb.js", "require": "./dist/breadcrumb.cjs" },
    "./divider": { "types": "./dist/entries/divider.d.ts", "import": "./dist/divider.js", "require": "./dist/divider.cjs" },
    "./empty": { "types": "./dist/entries/empty.d.ts", "import": "./dist/empty.js", "require": "./dist/empty.cjs" },
    "./pagination": { "types": "./dist/entries/pagination.d.ts", "import": "./dist/pagination.js", "require": "./dist/pagination.cjs" },
    "./progress": { "types": "./dist/entries/progress.d.ts", "import": "./dist/progress.js", "require": "./dist/progress.cjs" },
    "./skeleton": { "types": "./dist/entries/skeleton.d.ts", "import": "./dist/skeleton.js", "require": "./dist/skeleton.cjs" },
    "./spin": { "types": "./dist/entries/spin.d.ts", "import": "./dist/spin.js", "require": "./dist/spin.cjs" },
    "./tabs": { "types": "./dist/entries/tabs.d.ts", "import": "./dist/tabs.js", "require": "./dist/tabs.cjs" },
    "./card": { "types": "./dist/entries/card.d.ts", "import": "./dist/card.js", "require": "./dist/card.cjs" },
    "./descriptions": { "types": "./dist/entries/descriptions.d.ts", "import": "./dist/descriptions.js", "require": "./dist/descriptions.cjs" },
    "./steps": { "types": "./dist/entries/steps.d.ts", "import": "./dist/steps.js", "require": "./dist/steps.cjs" },
    "./timeline": { "types": "./dist/entries/timeline.d.ts", "import": "./dist/timeline.js", "require": "./dist/timeline.cjs" },
    "./collapse": { "types": "./dist/entries/collapse.d.ts", "import": "./dist/collapse.js", "require": "./dist/collapse.cjs" },
    "./date-picker": { "types": "./dist/entries/date-picker.d.ts", "import": "./dist/date-picker.js", "require": "./dist/date-picker.cjs" },
    "./upload": { "types": "./dist/entries/upload.d.ts", "import": "./dist/upload.js", "require": "./dist/upload.cjs" },
    "./drawer": { "types": "./dist/entries/drawer.d.ts", "import": "./dist/drawer.js", "require": "./dist/drawer.cjs" },
    "./form": { "types": "./dist/entries/form.d.ts", "import": "./dist/form.js", "require": "./dist/form.cjs" },
    "./resolvers/zod": {
      "types": "./dist/entries/zodResolver.d.ts",
      "import": "./dist/zodResolver.js"
    },
    "./resolvers/yup": {
      "types": "./dist/entries/yupResolver.d.ts",
      "import": "./dist/yupResolver.js"
    }
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": false },
    "react-dom": { "optional": false }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.0"
  }
}
